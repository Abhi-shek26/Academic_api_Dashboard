PORT=3000
NODE_ENV=development

# MongoDB Connection String (REQUIRED — e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Redis Connection URL (OPTIONAL — app runs fine without it; caching disabled)
# Get a free instance at https://upstash.com (Redis) and paste its URL here.
REDIS_URL=

# Admin API Key for protected POST /api/v1/chapters (send as x-api-key header)
ADMIN_API_KEY=change-me-to-a-strong-secret

# Rate Limiting Configuration
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
